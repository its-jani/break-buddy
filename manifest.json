{
  "manifest_version": 3,
  "name": "BreakBuddy",
  "version": "1.0.0",
  "description": "Enforces the 20-20-20 eye rest rule and movement breaks with a friendly full-screen character buddy.",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BreakBuddy Settings",
    "default_icon": {
      "128": "assets/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"],
      "css": ["styles/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "128": "assets/icon.png"
  }
}
